# ==============================================================================
# Reality bRand Check AI - Environment Configuration Template
# Copy this file to .env and fill in the values for local development.
# DO NOT commit real credentials or .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-to-a-secure-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./reality_brand_check.db
# For PostgreSQL: postgresql://username:password@localhost:5432/reality_brand_check

# ------------------------------------------------------------------------------
# AI Engine & LLM Provider API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE=Reality bRand Check AI

